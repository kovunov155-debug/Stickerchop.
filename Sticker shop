<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Sticker Shop — Telegram Mini App</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Telegram WebApp SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body { -webkit-tap-highlight-color: transparent; }
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-thumb { background: rgba(148, 163, 184, 0.2); border-radius: 9999px; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between selection:bg-purple-500 selection:text-white font-sans antialiased">

    <!-- Шапка приложения -->
    <header class="sticky top-0 z-40 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 p-4 flex justify-between items-center shadow-lg">
        <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-purple-500 to-pink-500 flex items-center justify-center text-base shadow">✨</div>
            <div>
                <h1 class="text-base font-bold bg-gradient-to-r from-purple-400 via-pink-400 to-amber-300 bg-clip-text text-transparent leading-tight">Sticker Shop</h1>
                <p class="text-[11px] text-slate-400">10 паков · 160+ стикеров Telegram</p>
            </div>
        </div>
        <button id="cart-btn" class="relative bg-slate-800/90 hover:bg-slate-700 border border-slate-700 px-3 py-2 rounded-xl text-sm font-medium transition flex items-center gap-1.5 shadow-md active:scale-95">
            🛒 <span id="cart-count" class="absolute -top-2 -right-2 bg-pink-500 text-white text-xs px-2 py-0.5 rounded-full font-bold shadow-md">0</span>
        </button>
    </header>

    <!-- Основной каталог -->
    <main class="p-4 max-w-md mx-auto flex-1 w-full pb-20 space-y-4">
        <!-- Поиск -->
        <div class="relative">
            <input id="search-input" type="text" placeholder="Поиск паков или эмодзи..." class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3.5 py-2 text-xs text-white placeholder-slate-500 outline-none focus:border-purple-500">
        </div>

        <div class="flex justify-between items-center">
            <h2 class="text-sm font-semibold text-slate-200 uppercase tracking-wide">Все стикерпаки</h2>
            <span class="text-xs text-amber-400 font-semibold bg-amber-400/10 px-2 py-0.5 rounded-md border border-amber-400/20">40–60 ⭐</span>
        </div>
        
        <!-- Сетка товаров -->
        <div id="products-grid" class="grid grid-cols-2 gap-3.5">
            <!-- Генерируется скриптом -->
        </div>
    </main>

    <!-- Модальное окно корзины -->
    <div id="cart-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-slate-900 w-full max-w-md rounded-t-3xl sm:rounded-2xl p-5 border border-slate-800 shadow-2xl max-h-[85vh] flex flex-col">
            <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-800">
                <div class="flex items-center gap-2">
                    <span class="text-lg">🛍️</span>
                    <h3 class="font-bold text-base text-white">Ваша корзина</h3>
                </div>
                <button id="close-cart" class="text-slate-400 hover:text-white text-2xl w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center leading-none">&times;</button>
            </div>
            
            <div id="cart-items" class="flex-1 overflow-y-auto space-y-2.5 mb-4 pr-1"></div>

            <div class="border-t border-slate-800 pt-3 mt-auto">
                <div class="flex justify-between items-center mb-3 text-sm font-semibold">
                    <span class="text-slate-300">Итого:</span>
                    <span id="cart-total" class="text-amber-300 font-bold text-base">0 ⭐</span>
                </div>
                <button id="checkout-btn" class="w-full bg-gradient-to-r from-purple-600 to-pink-600 hover:opacity-95 py-3.5 rounded-xl font-bold text-white transition shadow-lg shadow-pink-600/20 active:scale-[0.98]">
                    Оплатить заказ
                </button>
            </div>
        </div>
    </div>

    <script>
        // Безопасная инициализация Telegram SDK
        let tg = (typeof window !== 'undefined' && window.Telegram && window.Telegram.WebApp) ? window.Telegram.WebApp : null;
        if (tg) {
            try { tg.ready(); tg.expand(); } catch (e) {}
        }

        function triggerHaptic(style = 'light') {
            if (tg && tg.HapticFeedback) {
                try { tg.HapticFeedback.impactOccurred(style); } catch (e) {}
            }
        }

        // Каталог из 10 паков
        const products = [
            { id: 1, name: 'Cyber Cat Pack', ru: 'Кибер-Кот 2077', price: 50, emoji: '😼', count: 16 },
            { id: 2, name: 'Crypto Pepe', ru: 'Крипто Пепе Деген', price: 50, emoji: '🐸', count: 16 },
            { id: 3, name: 'Capybara Zen', ru: 'Капибара Дзен', price: 45, emoji: '🍊', count: 16 },
            { id: 4, name: 'Coffee & Deadline', ru: 'Кофеман & Дедлайн', price: 40, emoji: '☕', count: 16 },
            { id: 5, name: 'Retro Arcade 8-Bit', ru: 'Ретро Геймер', price: 45, emoji: '🕹️', count: 16 },
            { id: 6, name: 'Cyber Samurai', ru: 'Кибер Самурай', price: 60, emoji: '🗡️', count: 16 },
            { id: 7, name: 'Anime Vibes', ru: 'Аниме & Чиби', price: 60, emoji: '🌸', count: 16 },
            { id: 8, name: 'Pixel Ducks', ru: 'Пиксельные Утки', price: 40, emoji: '🦆', count: 16 },
            { id: 9, name: 'Space Hamster', ru: 'Космо-Хомяк Гагарин', price: 45, emoji: '🚀', count: 16 },
            { id: 10, name: 'Neon Shiba', ru: 'Неоновый Сиба Доге', price: 55, emoji: '🐕', count: 16 }
        ];

        let cart = [];

        function renderProducts(items = products) {
            const grid = document.getElementById('products-grid');
            if (!grid) return;
            grid.innerHTML = '';
            items.forEach(p => {
                grid.innerHTML += `
                    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-3 flex flex-col justify-between shadow-md hover:border-slate-700 transition">
                        <div>
                            <div class="w-full h-28 rounded-xl bg-gradient-to-br from-purple-950/40 to-slate-900 border border-slate-800 flex flex-col items-center justify-center mb-2">
                                <span class="text-4xl filter drop-shadow">${p.emoji}</span>
                                <span class="text-[10px] text-slate-400 mt-1">${p.count} стикеров</span>
                            </div>
                            <h3 class="font-semibold text-xs text-slate-100 truncate">${p.name}</h3>
                            <p class="text-[11px] text-slate-400 truncate">${p.ru}</p>
                        </div>
                        <div class="flex justify-between items-center mt-3 pt-2 border-t border-slate-800/60">
                            <span class="text-amber-400 font-bold text-xs">${p.price} ⭐</span>
                            <button onclick="addToCart(${p.id})" class="bg-purple-600 hover:bg-purple-500 text-white w-7 h-7 rounded-lg text-sm font-bold flex items-center justify-center transition active:scale-95">+</button>
                        </div>
                    </div>
                `;
            });
        }

        window.addToCart = function(id) {
            const prod = products.find(p => p.id === id);
            if (!prod) return;
            const item = cart.find(i => i.id === id);
            if (item) item.quantity++;
            else cart.push({ ...prod, quantity: 1 });
            updateCart();
            triggerHaptic('light');
        };

        window.changeQty = function(id, delta) {
            const item = cart.find(i => i.id === id);
            if (!item) return;
            item.quantity += delta;
            if (item.quantity <= 0) cart = cart.filter(i => i.id !== id);
            updateCart();
            triggerHaptic('light');
        };

        function updateCart() {
            const count = cart.reduce((s, i) => s + i.quantity, 0);
            document.getElementById('cart-count').innerText = count;
            const cont = document.getElementById('cart-items');
            cont.innerHTML = cart.length === 0 ? '<p class="text-center text-xs text-slate-400 py-8">Корзина пуста</p>' : '';
            cart.forEach(i => {
                cont.innerHTML += `
                    <div class="flex justify-between items-center bg-slate-950/60 p-2.5 rounded-xl border border-slate-800/60">
                        <div>
                            <h4 class="text-xs font-medium text-white">${i.name}</h4>
                            <p class="text-[11px] text-amber-400 font-semibold">${i.price} ⭐ × ${i.quantity}</p>
                        </div>
                        <div class="flex items-center gap-1 bg-slate-900 border border-slate-800 rounded-lg p-0.5">
                            <button onclick="changeQty(${i.id}, -1)" class="w-6 h-6 text-slate-300 text-xs font-bold active:scale-95">−</button>
                            <span class="text-xs font-mono font-bold px-1">${i.quantity}</span>
                            <button onclick="changeQty(${i.id}, 1)" class="w-6 h-6 text-slate-300 text-xs font-bold active:scale-95">+</button>
                        </div>
                    </div>
                `;
            });
            const total = cart.reduce((s, i) => s + i.price * i.quantity, 0);
            document.getElementById('cart-total').innerText = `${total} ⭐`;
        }

        document.addEventListener('DOMContentLoaded', () => {
            renderProducts();
            const modal = document.getElementById('cart-modal');
            document.getElementById('cart-btn').addEventListener('click', () => { triggerHaptic('light'); modal.classList.remove('hidden'); });
            document.getElementById('close-cart').addEventListener('click', () => modal.classList.add('hidden'));
            document.getElementById('search-input').addEventListener('input', (e) => {
                const q = e.target.value.toLowerCase().trim();
                renderProducts(products.filter(p => p.name.toLowerCase().includes(q) || p.ru.toLowerCase().includes(q) || p.emoji.includes(q)));
            });
            document.getElementById('checkout-btn').addEventListener('click', () => {
                if (cart.length === 0) return alert('Добавьте товары в корзину');
                triggerHaptic('heavy');
                if (tg && typeof tg.sendData === 'function') {
                    try { tg.sendData(JSON.stringify(cart)); } catch (e) {}
                }
                alert('Заказ успешно оформлен!');
                cart = [];
                updateCart();
                modal.classList.add('hidden');
            });
        });
    </script>
</body>
</html>
